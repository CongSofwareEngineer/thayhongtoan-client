# Backend NestJS API. Required — without it every request falls back to the
# current origin and returns 404.
NEXT_PUBLIC_API_APP=https://your-api.example.com

# 'production' disables zustand devtools
NEXT_PUBLIC_ENV=development

# Set to 1 in CI/Vercel to turn on the extra production optimisations in next.config.ts
NEXT_PUBLIC_BUILD=

# Salt for utils/CryptoJS
NEXT_PUBLIC_KEY_SALT=

# Enables GTM + GA + the Google site verification meta tag
MODE_DEPLOY=

# Sepay API key used by app/api/sepay (server only)
SEPAY_API_KEY=
